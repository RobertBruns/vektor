# Own login (single user marcel, file /var/www/virtual/marcel/.htpasswd-vektor)
AuthType Basic
AuthName "vektor"
AuthUserFile /var/www/virtual/marcel/.htpasswd-vektor
Require valid-user

# Always revalidate (cheap 304s) so html/js/css can never be a stale mix after a deploy
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header always set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

AddType application/manifest+json .webmanifest
